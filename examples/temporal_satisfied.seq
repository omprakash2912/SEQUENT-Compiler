// SEQUENT Phase 2 - Temporal Constraint Satisfied Demonstration
// EVENTS: EmergencyDetected@0ms, TeamDispatched@3200ms, IncidentResolved@4500ms
system EmergencyResponseSatisfied {

    state active = false
    state team = "AVAILABLE"

    event EmergencyDetected
    event TeamDispatched
    event IncidentResolved

    on EmergencyDetected {
        active = true
        team = "DISPATCHED"
    }

    on IncidentResolved {
        active = false
        team = "AVAILABLE"
    }

    constraint EmergencyDetected -> TeamDispatched within 5s
    constraint TeamDispatched -> IncidentResolved within 30m
}
